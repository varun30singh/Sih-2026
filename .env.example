# =========================================================
# MANDISETU - ENVIRONMENT CONFIGURATION TEMPLATE
# Smart India Hackathon 2026 (Problem SIH26032)
# =========================================================
# Copy this file to .env and adjust the values for your environment.
# NEVER commit your actual .env file or real secrets to Git.
# =========================================================

# ---------------------------------------------------------
# Application Ports & URLs
# ---------------------------------------------------------
NODE_ENV=development
PORT=4000
BACKEND_PORT=4000
FRONTEND_PORT=3000
CHATBOT_PORT=5000

API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_CHATBOT_API_URL=http://127.0.0.1:5000/api

# ---------------------------------------------------------
# Primary Database (PostgreSQL)
# ---------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_NAME=mandisetu_db
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/mandisetu_db

# ---------------------------------------------------------
# In-Memory Cache & Live Queue (Redis)
# ---------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------
# ProcureAI / Python Chatbot & LLM Integration
# ---------------------------------------------------------
PROCUREAI_LLM_PROVIDER=openai
PROCUREAI_LLM_API_KEY=your_llm_api_key_here
PROCUREAI_LLM_MODEL=gpt-5-mini
PROCUREAI_LLM_ENABLED=true
PROCUREAI_LLM_TIMEOUT=30
PROCUREAI_DEBUG=0
PROCUREMENT_DB_PATH=database/procurement.db
