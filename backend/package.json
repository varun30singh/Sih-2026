{
  "name": "mandisetu-backend",
  "version": "1.0.0",
  "description": "MandiSetu NestJS & Node.js Application Backend for Smart Procurement Logistics",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "node dist/main.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.1",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.23.1",
    "prisma": "^8.0.0-rc.15",
    "typescript": "^5.7.2"
  }
}
